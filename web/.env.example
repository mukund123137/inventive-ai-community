# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both are safe to expose to the browser —
# access control is enforced by RLS (see supabase/migrations), not by
# keeping these secret.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
